{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Remote Print Protocol",
  "version": "1.0.0",
  "description": "Standardized mutual schemas for Android Client and Windows Print Agent over Tailscale",
  "definitions": {
    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["healthy", "degraded", "maintenance"] },
        "service": { "type": "string", "example": "SmartRemotePrintAgent" },
        "version": { "type": "string", "example": "1.0.0" },
        "machineName": { "type": "string", "example": "desktop-00ctdtl" },
        "tailscaleHostname": { "type": "string", "example": "desktop-00ctdtl.tailfc14cd.ts.net" },
        "port": { "type": "integer", "example": 8766 },
        "uptimeSeconds": { "type": "number" },
        "defaultPrinter": { "type": "string", "example": "Brother DCP-T530DW Printer" }
      },
      "required": ["status", "service", "version", "machineName", "port"]
    },
    "PairingRequest": {
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "description": "Unique Android client UUID or hardware fingerprint" },
        "deviceName": { "type": "string", "description": "Human friendly name (e.g. Lenovo Tab P12)" },
        "pairingPin": { "type": "string", "description": "6-digit OTP generated by Windows Agent console", "pattern": "^[0-9]{6}$" }
      },
      "required": ["deviceId", "deviceName", "pairingPin"]
    },
    "PairingResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "authToken": { "type": "string", "description": "Cryptographically secure bearer token" },
        "expiresAtUtc": { "type": "string", "format": "date-time" },
        "serverFingerprint": { "type": "string", "description": "SHA-256 fingerprint of server identity" }
      },
      "required": ["success", "authToken"]
    },
    "PrinterQueueInfo": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "example": "Brother DCP-T530DW Printer" },
        "driverName": { "type": "string", "example": "Brother DCP-T530DW Printer" },
        "portName": { "type": "string", "example": "USB001" },
        "isDefault": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Ready", "Printing", "Paused", "Error", "Offline", "PaperJam", "OutOfPaper"] },
        "connectionType": { "type": "string", "enum": ["USB", "Network_WiFi", "Virtual", "Other"] },
        "supportedPaperSizes": { "type": "array", "items": { "type": "string" } },
        "supportsColor": { "type": "boolean" },
        "supportsDuplex": { "type": "boolean" }
      },
      "required": ["name", "isOnline", "status", "portName"]
    },
    "PrintJobSubmission": {
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "clientTimestamp": { "type": "string", "format": "date-time" },
        "printerName": { "type": "string", "example": "Brother DCP-T530DW Printer" },
        "documentName": { "type": "string", "example": "Marg_Invoice_2026.pdf" },
        "copies": { "type": "integer", "minimum": 1, "maximum": 99, "default": 1 },
        "colorMode": { "type": "string", "enum": ["Color", "Monochrome"], "default": "Color" },
        "duplex": { "type": "string", "enum": ["Simplex", "DuplexLongEdge", "DuplexShortEdge"], "default": "Simplex" },
        "paperSize": { "type": "string", "enum": ["A4", "Letter", "Legal"], "default": "A4" },
        "fileSha256": { "type": "string", "description": "SHA-256 checksum of the uploaded PDF payload" }
      },
      "required": ["jobId", "printerName", "fileSha256"]
    },
    "PrintJobStatus": {
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "windowsSpoolerJobId": { "type": "integer" },
        "state": { "type": "string", "enum": ["Queued", "Spooling", "Printing", "Completed", "Failed", "Cancelled"] },
        "errorMessage": { "type": "string", "nullable": true },
        "pagesSubmitted": { "type": "integer" },
        "pagesPrinted": { "type": "integer" },
        "submittedAtUtc": { "type": "string", "format": "date-time" },
        "completedAtUtc": { "type": "string", "format": "date-time", "nullable": true }
      },
      "required": ["jobId", "state"]
    }
  }
}
